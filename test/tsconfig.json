{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "target": "ES2022",
    "types": ["bun-types"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "../src/**/*.ts"]
}
